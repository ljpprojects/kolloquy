{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kolloquy",
  "main": "./build/index.js",
  "compatibility_date": "2025-12-17",
  "env": {
    "dev": {
      "build": {
        "command": "cargo install worker-build@^0.7 && bash ./build.sh",
        "watch_dir": [
          "./frontend",
          "./src",
          "./build.sh",
          "./wrangler.jsonc",
          "./.env",
          "./custom-shim.mjs",
          "./Cargo.toml",
          "./.cargo/config.toml"
        ]
      },
      "kv_namespaces": [
        {
          "binding": "kSESSIONS",
          "id": "18e36d31cf6048b38ba9fa8b72bdb8d8"
        }
      ],
      "d1_databases": [
        {
          "binding": "kDB",
          "database_name": "kDB",
          "database_id": "c3e85642-1c72-4b0f-8ad2-5a368faf76bc"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "k-store",
          "binding": "kSTORE"
        }
      ]
    }
  },
  "build": {
    "command": "cargo install worker-build@^0.7 && RELEASE_BUILD=1 bash ./build.sh",
    "watch_dir": [
      "./assets",
      "./frontend/*.handlebars",
      "./frontend/*.html",
      "./frontend/css/*.css",
      "./frontend/ts/*.ts",
      "./src",
      "./build.sh",
      "./wrangler.jsonc",
      "./.env",
      "./custom-shim.mjs",
      "./Cargo.toml",
      "./.cargo/config.toml"
    ]
  },
  "assets": {
    "not_found_handling": "none",
    "directory": "./assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "kSESSIONS",
      "id": "18e36d31cf6048b38ba9fa8b72bdb8d8"
    }
  ],
  "d1_databases": [
    {
      "binding": "kDB",
      "database_name": "kDB",
      "database_id": "c3e85642-1c72-4b0f-8ad2-5a368faf76bc"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "k-store",
      "binding": "kSTORE"
    }
  ]
}
